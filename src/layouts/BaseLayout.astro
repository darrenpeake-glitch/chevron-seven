---
import '../styles/global.css';
import '../styles/archive.css';
import '../styles/lore.css';
import '../styles/bigger-picture.css';
import '../styles/brand.css';
import '../styles/progressive-disclosure.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Chevron Seven',
  description = 'The Stargate rewatch companion.'
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/chevron-seven-mark.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Chevron Seven home">
          <img class="brand-mark" src="/brand/chevron-seven-mark.svg" alt="" width="44" height="52" />
          <span class="brand-copy">
            <span class="brand-wordmark">Chevron Seven</span>
            <span class="brand-tagline">The Stargate rewatch companion</span>
          </span>
        </a>
        <nav aria-label="Primary navigation">
          <a href="/watch-order">Watch Order</a>
          <a href="/episodes">Mission Log</a>
          <a href="/quotes">Quotes</a>
          <a href="/threads">Threads</a>
          <a href="/archive">Archive</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <script is:inline src="/watch-progress.js"></script>
    <script is:inline src="/progressive-disclosure.js"></script>

    <footer class="footer">
      <div class="shell">
        Chevron Seven is an unofficial fan project. Stargate and related marks belong to their respective rights holders.
      </div>
    </footer>
  </body>
</html>
