---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { archiveTypes, valuesForType, episodesForValue, slugify, episodeCode, type ArchiveType } from '../../../lib/archive';
import { watchKeyForEpisode } from '../../../lib/watch-order';

export async function getStaticPaths() {
  const episodes = (await getCollection('episodes')).filter((entry) => !entry.data.draft);
  return Object.keys(archiveTypes).flatMap((rawType) => {
    const type = rawType as ArchiveType;
    return valuesForType(episodes, type).map((value) => ({
      params: { type, slug: slugify(value) },
      props: { type, value }
    }));
  });
}

const { type, value } = Astro.props as { type: ArchiveType; value: string };
const config = archiveTypes[type];
const episodes = (await getCollection('episodes')).filter((entry) => !entry.data.draft);
const linked = episodesForValue(episodes, type, value);
const loreRecords = (await getCollection('lore')).filter((entry) => !entry.data.draft);
const lore = loreRecords.find((entry) => entry.data.type === type && entry.data.name === value);
const renderedLore = lore ? await render(lore) : null;
const LoreContent = renderedLore?.Content;
const formatPoint = (point) => point
  ? `${point.series} S${String(point.season).padStart(2, '0')}E${String(point.episode).padStart(2, '0')}`
  : null;
const coreUnlockKey = lore?.data.safeThrough
  ? watchKeyForEpisode(lore.data.safeThrough.series, lore.data.safeThrough.season, lore.data.safeThrough.episode)
  : null;
const safeThrough = formatPoint(lore?.data.safeThrough);
---
<BaseLayout title={`${value} · ${config.label} · Chevron Seven`} description={lore?.data.summary ?? `${value} archive record in Chevron Seven.`}>
  <section class="archive-hero archive-record-hero">
    <div class="shell archive-entity-hero">
      <div>
        <div class="eyebrow">{config.singular}</div>
        <h1 class="episode-title">{value}</h1>
        {lore?.data.subtitle && <div class="archive-subtitle">{lore.data.subtitle}</div>}
        <p class="lede">{lore?.data.summary ?? `Indexed automatically from mission metadata. This record currently links to ${linked.length} archived ${linked.length === 1 ? 'mission' : 'missions'}.`}</p>
      </div>
      <div class="archive-entity-count" aria-label={`${linked.length} linked missions`}>
        <strong>{String(linked.length).padStart(2, '0')}</strong>
        <span>linked {linked.length === 1 ? 'mission' : 'missions'}</span>
      </div>
    </div>
  </section>

  <section class="mission-bar">
    <div class="shell mission-bar-inner">
      <div><span class="mission-label">Archive class</span><strong>{config.label}</strong></div>
      <div><span class="mission-label">Linked missions</span><strong>{linked.length}</strong></div>
      <div><span class="mission-label">Status</span><strong>{lore?.data.status ?? 'ACTIVE RECORD'}</strong></div>
    </div>
  </section>

  {lore && LoreContent && (
    <section class="section lore-section">
      <div class="shell lore-layout">
        <main class="lore-main">
          <div class="section-heading lore-heading">
            <div>
              <div class="eyebrow">Curated archive intelligence</div>
              <h2>Record briefing</h2>
            </div>
          </div>

          <article
            class="mission-article lore-article"
            data-progress-key={coreUnlockKey || undefined}
            data-progress-label={safeThrough ? `Record briefing unlocks after ${safeThrough}.` : undefined}
          >
            <LoreContent />
          </article>

          {lore.data.revelations.map((revelation) => {
            const unlockKey = watchKeyForEpisode(revelation.after.series, revelation.after.season, revelation.after.episode);
            const unlockLabel = `Archive update unlocks after ${formatPoint(revelation.after)}.`;
            return (
              <section class="lore-revelation" data-progress-key={unlockKey} data-progress-label={unlockLabel}>
                <div class="eyebrow">New intelligence</div>
                <h3>{revelation.heading}</h3>
                <p>{revelation.text}</p>
              </section>
            );
          })}
        </main>

        <aside class="lore-sidebar">
          <div class="sidebar-panel">
            <div class="eyebrow">Spoiler control</div>
            <div class="metric-list">
              <div class="metric-row"><span>Scope</span><strong class="capitalize">{lore.data.spoilerLevel}</strong></div>
              {safeThrough && <div class="metric-row"><span>Briefing unlock</span><strong>{safeThrough}</strong></div>}
              <div class="metric-row"><span>Disclosure</span><strong>Watch-state driven</strong></div>
            </div>
          </div>
          {lore.data.aliases.length > 0 && (
            <div class="sidebar-panel">
              <div class="eyebrow">Known as</div>
              <div class="archive-list lore-aliases">{lore.data.aliases.map((alias) => <span>{alias}</span>)}</div>
            </div>
          )}
        </aside>
      </div>
    </section>
  )}

  <section class="section archive-backlinks-section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Mission backlinks</div>
          <h2>Referenced missions</h2>
        </div>
        <a class="text-link" href={`/archive/${type}/`}>← {config.label}</a>
      </div>

      <div class="archive-mission-list">
        {linked.map((entry) => (
          <a class="archive-mission-row" href={`/episodes/${entry.id}/`}>
            <div class="archive-mission-code">{episodeCode(entry)}</div>
            <div class="archive-mission-copy">
              <span class="mission-label">{entry.data.series}</span>
              <strong>{entry.data.title}</strong>
              <div class="pills compact-pills">
                {entry.data.missionType.slice(0, 3).map((item) => <span class="pill">{item}</span>)}
              </div>
            </div>
            <div class="archive-mission-score">Rewatch <strong>{entry.data.rewatchRating}/5</strong> →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
