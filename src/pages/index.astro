---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { watchOrder, watchKeyForEpisode, codeForWatchEntry } from '../lib/watch-order';

const episodes = (await getCollection('episodes'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => {
    if (a.data.series !== b.data.series) return a.data.series.localeCompare(b.data.series);
    if (a.data.season !== b.data.season) return a.data.season - b.data.season;
    return a.data.episode - b.data.episode;
  });
const films = (await getCollection('films')).filter((entry) => !entry.data.draft);

const latest = episodes.slice(-3).reverse();
const archiveHrefByKey = new Map([
  ...episodes.map((entry) => [watchKeyForEpisode(entry.data.series, entry.data.season, entry.data.episode), `/episodes/${entry.id}/`]),
  ...films.map((entry) => [entry.data.watchKey, `/films/${entry.id}/`])
]);
const progressEntries = watchOrder.map((entry, index) => ({
  key: entry.key,
  index,
  series: entry.series,
  code: codeForWatchEntry(entry),
  title: entry.title,
  archiveHref: archiveHrefByKey.get(entry.key) ?? null
}));
---
<BaseLayout>
  <section class="hero hero-gate">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Incoming wormhole</div>
        <h1>Chevron Seven</h1>
        <p class="lede">
          The Stargate rewatch companion: episode context, continuity, lore,
          characters, technology — and the occasional Teal'c eyebrow.
        </p>
        <div class="hero-actions">
          <a class="button-primary" href="/episodes">Enter mission log</a>
          <a class="button-quiet" href="/archive">Open archive</a>
        </div>
      </div>

      <aside class="gate-status" aria-label="Current rewatch status">
        <div class="gate-disc" aria-hidden="true"><span>7</span></div>
        <div class="status-copy">
          <div class="eyebrow">Current position</div>
          <strong id="home-current-code">Watch progress not set</strong>
          <span id="home-current-title">Mark an entry watched to establish your spoiler boundary.</span>
          <a class="text-link" id="home-current-link" href="/watch-order">Open watch order →</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Current mission log</div>
          <h2>Latest archive entries</h2>
        </div>
        <a class="text-link" href="/episodes">View all missions →</a>
      </div>
      <div class="grid episode-grid">
        {latest.map((entry) => (
          <a class="card episode-card" href={`/episodes/${entry.id}/`}>
            <div class="episode-card-top">
              <div>
                <div class="meta">MISSION RECORD · {entry.data.series}</div>
                <h3>{entry.data.title}</h3>
              </div>
              <div class="episode-number">S{entry.data.season}E{entry.data.episode}</div>
            </div>
            <div class="pills">
              <span class="pill">Rewatch {entry.data.rewatchRating}/5</span>
              {entry.data.oneillSarcasm !== undefined && <span class="pill">O'Neill {entry.data.oneillSarcasm}/10</span>}
              {entry.data.tealcEyebrow && <span class="pill">Eyebrow: {entry.data.tealcEyebrow}</span>}
            </div>
            <div class="card-footer">Open mission file <span>→</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="shell">
      <div class="eyebrow">Archive design</div>
      <h2>Built around the rewatch</h2>
      <div class="grid principles-grid">
        <div class="card principle-card"><span class="principle-code">01</span><h3>Why It Matters</h3><p class="meta">The continuity and lore contribution without a bloated plot recap.</p></div>
        <div class="card principle-card"><span class="principle-code">02</span><h3>Cross-linked lore</h3><p class="meta">Characters, factions, worlds, technology and story arcs become browsable indexes.</p></div>
        <div class="card principle-card"><span class="principle-code">03</span><h3>Essential metrics</h3><p class="meta">Rewatch score, O'Neill Sarcasm Rating and the Teal'c Eyebrow Index.</p></div>
      </div>
    </div>
  </section>

  <script id="home-watch-data" type="application/json" set:html={JSON.stringify(progressEntries)}></script>
  <script is:inline src="/watch-progress.js"></script>
  <script is:inline>
    (() => {
      if (!window.ChevronWatch) return;
      const entries = JSON.parse(document.getElementById('home-watch-data').textContent || '[]');
      const code = document.getElementById('home-current-code');
      const title = document.getElementById('home-current-title');
      const link = document.getElementById('home-current-link');

      const render = () => {
        const watched = new Set(window.ChevronWatch.load());
        const current = [...entries].reverse().find((entry) => watched.has(entry.key));
        if (!current) {
          code.textContent = 'Watch progress not set';
          title.textContent = 'Mark an entry watched to establish your spoiler boundary.';
          link.textContent = 'Open watch order →';
          link.href = '/watch-order';
          return;
        }
        code.textContent = `${current.series} · ${current.code}`;
        title.textContent = current.title;
        if (current.archiveHref) {
          link.textContent = 'Open current mission →';
          link.href = current.archiveHref;
        } else {
          link.textContent = 'Open watch order →';
          link.href = '/watch-order';
        }
      };

      window.addEventListener('chevron-watch-change', render);
      render();
    })();
  </script>
</BaseLayout>
