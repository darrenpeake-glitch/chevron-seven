---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const episodes = (await getCollection('episodes'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => {
    if (a.data.series !== b.data.series) return a.data.series.localeCompare(b.data.series);
    if (a.data.season !== b.data.season) return a.data.season - b.data.season;
    return a.data.episode - b.data.episode;
  });

const current = episodes.at(-1);

const groups = new Map();
for (const entry of episodes) {
  const key = `${entry.data.series}-${entry.data.season}`;
  if (!groups.has(key)) {
    groups.set(key, {
      series: entry.data.series,
      season: entry.data.season,
      episodes: []
    });
  }
  groups.get(key).episodes.push(entry);
}

const seasons = Array.from(groups.values());
const formatCode = (entry) => `S${String(entry.data.season).padStart(2, '0')}E${String(entry.data.episode).padStart(2, '0')}`;
---
<BaseLayout title="Mission Log · Chevron Seven" description="Browse the Chevron Seven Stargate rewatch mission archive by series and season.">
  <section class="log-hero">
    <div class="shell log-hero-grid">
      <div>
        <div class="eyebrow">SGC archive terminal</div>
        <h1 class="episode-title">Mission Log</h1>
        <p class="lede">Episode-by-episode rewatch records, grouped by season and built to grow with the archive.</p>
      </div>

      {current && (
        <a class="log-current" href={`/episodes/${current.id}/`}>
          <span class="mission-label">Current position</span>
          <strong>{current.data.series} · {formatCode(current)}</strong>
          <span>{current.data.title}</span>
          <small>Open current mission →</small>
        </a>
      )}
    </div>
  </section>

  <section class="log-summary">
    <div class="shell log-summary-grid">
      <div><span class="mission-label">Archived missions</span><strong>{episodes.length}</strong></div>
      <div><span class="mission-label">Series active</span><strong>{new Set(episodes.map((e) => e.data.series)).size}</strong></div>
      <div><span class="mission-label">Seasons represented</span><strong>{seasons.length}</strong></div>
    </div>
  </section>

  <section class="section log-body">
    <div class="shell">
      {seasons.map((season) => (
        <section class="season-block" id={`${season.series.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-season-${season.season}`}>
          <header class="season-heading">
            <div>
              <div class="eyebrow">{season.series}</div>
              <h2>Season {season.season}</h2>
            </div>
            <span>{season.episodes.length} mission{season.episodes.length === 1 ? '' : 's'} archived</span>
          </header>

          <div class="season-list">
            {season.episodes.map((entry) => {
              const isCurrent = current?.id === entry.id;
              return (
                <a class:list={["mission-row", isCurrent && "is-current"]} href={`/episodes/${entry.id}/`}>
                  <div class="mission-row-code">{formatCode(entry)}</div>
                  <div class="mission-row-copy">
                    <div class="mission-row-titleline">
                      <h3>{entry.data.title}</h3>
                      {isCurrent && <span class="current-badge">Current position</span>}
                    </div>
                    <div class="mission-row-tags">
                      {entry.data.missionType.slice(0, 3).map((item) => <span>{item}</span>)}
                    </div>
                  </div>
                  <div class="mission-row-metrics">
                    <span>Rewatch <strong>{entry.data.rewatchRating}/5</strong></span>
                    {entry.data.oneillSarcasm !== undefined && <span>O'Neill <strong>{entry.data.oneillSarcasm}/10</strong></span>}
                  </div>
                  <div class="mission-row-arrow">→</div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </section>

  <style>
    .log-hero { padding: 5rem 0 3.5rem; border-bottom: 1px solid var(--line); background: radial-gradient(circle at 82% 18%, rgba(212,167,76,.08), transparent 22rem); }
    .log-hero-grid { display: grid; grid-template-columns: minmax(0,1fr) 300px; gap: 4rem; align-items: end; }
    .log-current { text-decoration: none; border: 1px solid var(--line); background: var(--panel); border-radius: 14px; padding: 1.2rem; min-height: 160px; display: grid; align-content: end; gap: .32rem; position: relative; overflow: hidden; }
    .log-current::before { content: ""; position: absolute; width: 180px; height: 180px; right: -70px; top: -95px; border-radius: 50%; border: 1px solid rgba(212,167,76,.12); }
    .log-current strong { font-size: 1.05rem; }
    .log-current > span:nth-of-type(2) { color: var(--muted); }
    .log-current small { color: var(--accent); margin-top: .6rem; }
    .log-summary { border-bottom: 1px solid var(--line); background: #0b1013; }
    .log-summary-grid { display: grid; grid-template-columns: repeat(3,1fr); }
    .log-summary-grid > div { padding: 1rem 1.2rem; border-right: 1px solid var(--line); display: grid; gap: .25rem; }
    .log-summary-grid > div:first-child { padding-left: 0; }
    .log-summary-grid > div:last-child { border-right: 0; }
    .log-summary-grid strong { font-size: 1.1rem; color: var(--text); }
    .log-body { padding-top: 3rem; }
    .season-block + .season-block { margin-top: 4rem; }
    .season-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
    .season-heading h2 { margin: .2rem 0 0; }
    .season-heading > span { color: var(--muted); font-size: .85rem; }
    .season-list { display: grid; }
    .mission-row { display: grid; grid-template-columns: 95px minmax(0,1fr) auto 28px; gap: 1.25rem; align-items: center; text-decoration: none; padding: 1.1rem 0; border-bottom: 1px solid rgba(41,53,59,.72); transition: background .15s ease, border-color .15s ease; }
    .mission-row:hover { background: rgba(255,255,255,.018); border-color: var(--accent-soft); }
    .mission-row.is-current { margin: .45rem 0; padding: 1rem; border: 1px solid rgba(212,167,76,.35); border-radius: 12px; background: rgba(212,167,76,.035); }
    .mission-row-code { color: var(--accent); font-size: .8rem; font-weight: 800; letter-spacing: .08em; }
    .mission-row-titleline { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .mission-row h3 { margin: 0; font-size: 1.15rem; }
    .current-badge { font-size: .66rem; color: #111; background: var(--accent); border-radius: 999px; padding: .24rem .5rem; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; }
    .mission-row-tags { display: flex; gap: .45rem; flex-wrap: wrap; margin-top: .4rem; }
    .mission-row-tags span { color: var(--muted); font-size: .72rem; border: 1px solid var(--line); border-radius: 999px; padding: .2rem .45rem; }
    .mission-row-metrics { display: flex; gap: 1rem; color: var(--muted); font-size: .75rem; white-space: nowrap; }
    .mission-row-metrics strong { color: var(--text); }
    .mission-row-arrow { color: var(--muted); text-align: right; }
    .mission-row:hover .mission-row-arrow { color: var(--accent); }

    @media (max-width: 800px) {
      .log-hero-grid { grid-template-columns: 1fr; gap: 2rem; }
      .log-current { min-height: 130px; }
      .mission-row { grid-template-columns: 72px minmax(0,1fr) 24px; }
      .mission-row-metrics { grid-column: 2; margin-top: -.25rem; }
      .mission-row-arrow { grid-column: 3; grid-row: 1 / span 2; }
    }

    @media (max-width: 560px) {
      .log-summary-grid { grid-template-columns: 1fr; }
      .log-summary-grid > div { border-right: 0; border-bottom: 1px solid var(--line); padding-left: 0; }
      .log-summary-grid > div:last-child { border-bottom: 0; }
      .season-heading { align-items: flex-start; flex-direction: column; gap: .5rem; }
      .mission-row, .mission-row.is-current { grid-template-columns: 1fr 24px; gap: .7rem; padding: 1rem 0; border-radius: 0; border-left: 0; border-right: 0; }
      .mission-row.is-current { padding: 1rem .75rem; border-left: 1px solid rgba(212,167,76,.35); border-right: 1px solid rgba(212,167,76,.35); border-radius: 10px; }
      .mission-row-code { grid-column: 1; }
      .mission-row-copy { grid-column: 1; }
      .mission-row-metrics { grid-column: 1; }
      .mission-row-arrow { grid-column: 2; grid-row: 1 / span 3; }
    }
  </style>
</BaseLayout>
