---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../lib/archive';
import { watchOrder, watchOrderIndex, watchKeyForEpisode, codeForWatchEntry } from '../../lib/watch-order';

export async function getStaticPaths() {
  const episodes = await getCollection('episodes');
  const published = episodes
    .filter((entry) => !entry.data.draft)
    .sort((a, b) => {
      if (a.data.series !== b.data.series) return a.data.series.localeCompare(b.data.series);
      if (a.data.season !== b.data.season) return a.data.season - b.data.season;
      return a.data.episode - b.data.episode;
    });

  return published.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      previous: index > 0 && published[index - 1].data.series === entry.data.series ? published[index - 1] : null,
      next: index < published.length - 1 && published[index + 1].data.series === entry.data.series ? published[index + 1] : null
    }
  }));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const threadRecords = (await getCollection('threads')).filter((thread) => !thread.data.draft);
const threadName = (id: string) => threadRecords.find((thread) => thread.id === id)?.data.name ?? id;
const episodeRecords = (await getCollection('episodes')).filter((episode) => !episode.data.draft);
const filmRecords = (await getCollection('films')).filter((film) => !film.data.draft);
const missionHrefByKey = new Map<string, string>();
for (const episode of episodeRecords) {
  missionHrefByKey.set(
    watchKeyForEpisode(episode.data.series, episode.data.season, episode.data.episode),
    `/episodes/${episode.id}/`
  );
}
for (const film of filmRecords) missionHrefByKey.set(film.data.watchKey, `/films/${film.id}/`);
const watchEntryByKey = new Map(watchOrder.map((watchEntry) => [watchEntry.key, watchEntry]));
const previouslyRelevant = d.previouslyRelevant
  .map((link) => {
    const watchEntry = watchEntryByKey.get(link.watchKey);
    if (!watchEntry) return null;
    return {
      ...link,
      title: watchEntry.title,
      series: watchEntry.series,
      code: codeForWatchEntry(watchEntry),
      href: missionHrefByKey.get(link.watchKey) ?? '/watch-order'
    };
  })
  .filter(Boolean);
const episodeCode = `S${String(d.season).padStart(2, '0')}E${String(d.episode).padStart(2, '0')}`;
const watchKey = watchKeyForEpisode(d.series, d.season, d.episode);
const watchIndex = watchOrderIndex.get(watchKey);
const throughKeys = watchIndex === undefined ? [watchKey] : watchOrder.slice(0, watchIndex + 1).map((item) => item.key);
const spoilerCopy = d.spoilerLevel === 'episode'
  ? 'Safe after completing this episode.'
  : d.spoilerLevel === 'season'
    ? 'May reference later events in this season.'
    : 'Full-series retrospective spoilers possible.';
const continuityLabel = d.continuityWeight.charAt(0).toUpperCase() + d.continuityWeight.slice(1);
---
<BaseLayout title={`${d.title} · Chevron Seven`} description={`${d.series} ${episodeCode} — ${d.title}. Chevron Seven mission file.`}>
  <section class="mission-hero">
    <div class="shell mission-hero-grid">
      <div>
        <div class="mission-kicker">
          <span>MISSION FILE</span>
          <span>{d.series}</span>
          <span>{episodeCode}</span>
        </div>
        <h1 class="episode-title">{d.title}</h1>
        <div class="pills mission-types">
          {d.missionType.map((item) => <span class="pill">{item}</span>)}
        </div>
      </div>

      <aside class="mission-status" aria-label="Mission status">
        <div class="mission-code">{episodeCode}</div>
        <div class="eyebrow">Archive status</div>
        <strong>FILE OPEN</strong>
        <span>{d.series} · Season {d.season}</span>
      </aside>
    </div>
  </section>

  <section class="mission-bar">
    <div class="shell mission-bar-inner">
      <div><span class="mission-label">Spoiler boundary</span><strong>{spoilerCopy}</strong></div>
      <div><span class="mission-label">Archive scope</span><strong>{d.spoilerLevel}</strong></div>
      <div><span class="mission-label">Record</span><strong>{d.series} / {episodeCode}</strong></div>
    </div>
  </section>

  <section class="section mission-body-section">
    <div class="shell mission-layout">
      <main class="mission-main">
        <section class="episode-reading briefing-panel" data-watch-when="unwatched">
          <div class="eyebrow">Before you watch · spoiler-safe</div>
          <h2>Mission Briefing</h2>
          <p>{d.briefing}</p>
          <div class="briefing-lock">Full debrief, significance and narrative connections unlock when this episode is marked watched.</div>
        </section>

        <div data-watch-when="watched" hidden>
          <section class="episode-reading debrief-panel">
            <div class="eyebrow">After-action record</div>
            <h2>Mission Debrief</h2>
            <p>{d.debrief}</p>

            <div class="why-it-matters">
              <div class="eyebrow">Continuity significance</div>
              <h3>Why It Matters</h3>
              <p>{d.whyItMatters}</p>
            </div>
          </section>

          {previouslyRelevant.length > 0 && (
            <section class="previously-relevant" aria-labelledby="previously-relevant-title">
              <div class="eyebrow">Continuity refresher</div>
              <h2 id="previously-relevant-title">Previously Relevant</h2>
              <p class="previously-relevant-intro">Earlier missions that materially set up this one.</p>
              <div class="previously-relevant-list">
                {previouslyRelevant.map((link) => link && (
                  <a href={link.href}>
                    <div class="previously-relevant-code">
                      <span>{link.series}</span>
                      <strong>{link.code}</strong>
                    </div>
                    <div class="previously-relevant-copy">
                      <strong>{link.title}</strong>
                      <span>{link.reason}</span>
                    </div>
                    <b aria-hidden="true">→</b>
                  </a>
                ))}
              </div>
            </section>
          )}

          {d.biggerPicture && (
            <section class="bigger-picture" aria-labelledby="bigger-picture-title">
              <div class="bigger-picture-head">
                <div>
                  <div class="eyebrow">Franchise significance</div>
                  <h2 id="bigger-picture-title">Bigger Picture</h2>
                </div>
                <span class="bigger-picture-badge">THREAD ACTIVE</span>
              </div>
              <p>{d.biggerPicture.summary}</p>
              {d.biggerPicture.threads.length > 0 && (
                <div class="bigger-picture-threads">
                  {d.biggerPicture.threads.map((thread) => <span>{thread}</span>)}
                </div>
              )}
              {d.biggerPicture.fullContext && (
                <details class="bigger-picture-full">
                  <summary>Full franchise context — later spoilers</summary>
                  <p>{d.biggerPicture.fullContext}</p>
                </details>
              )}
            </section>
          )}

          {d.narrativeThreads.length > 0 && (
            <section class="episode-thread-links" aria-labelledby="episode-thread-title">
              <div class="eyebrow">Long-game narrative</div>
              <h2 id="episode-thread-title">Narrative Threads</h2>
              <div class="episode-thread-list">
                {d.narrativeThreads.map((link) => (
                  <a href={`/threads/${link.thread}/`}>
                    <div>
                      <strong>{threadName(link.thread)}</strong>
                      {link.note && <span>{link.note}</span>}
                    </div>
                    <div class="episode-thread-meta">
                      <span>{link.role.replace('-', ' ')}</span>
                      <span>{link.relevance}</span>
                      <b>→</b>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}

          <article class="mission-article"><Content /></article>
        </div>
      </main>

      <aside class="mission-sidebar">
        <div class="sidebar-panel watch-panel" data-watch-key={watchKey}>
          <div class="eyebrow">Your watch progress</div>
          <strong class="watch-state" id="mission-watch-state">Not marked watched</strong>
          <div class="watch-actions">
            <button class="watch-action primary-watch" id="mission-watch-toggle" type="button">Mark watched</button>
            <button class="watch-action" id="mission-watch-through" type="button">Mark watched through here</button>
          </div>
          <a class="text-link watch-order-link" href="/watch-order">Open full watch order →</a>
        </div>

        <div data-watch-when="watched" hidden>
          <div class="sidebar-panel gated-sidebar-panel continuity-panel">
            <div class="eyebrow">Continuity profile</div>
            <div class="continuity-weight"><span>Weight</span><strong>{continuityLabel}</strong></div>
            {d.connections.length > 0 ? (
              <div class="connection-pills">{d.connections.map((item) => <span>{item}</span>)}</div>
            ) : (
              <p class="continuity-empty">No specialist connection tags assigned.</p>
            )}
          </div>

          <div class="sidebar-panel gated-sidebar-panel">
            <div class="eyebrow">Chevron Seven metrics</div>
            <div class="metric-list">
              <div class="metric-row"><span>Rewatch rating</span><strong>{d.rewatchRating}/5</strong></div>
              {d.oneillSarcasm !== undefined && <div class="metric-row"><span>O'Neill sarcasm</span><strong>{d.oneillSarcasm}/10</strong></div>}
              {d.tealcEyebrow && <div class="metric-row"><span>Teal'c eyebrow</span><strong class="capitalize">{d.tealcEyebrow}</strong></div>}
            </div>
          </div>

          <div class="sidebar-panel gated-sidebar-panel">
            <div class="eyebrow">Archive links</div>
            {d.characters.length > 0 && <div class="archive-group"><a class="mission-label archive-group-link" href="/archive/personnel/">Personnel</a><div class="archive-list">{d.characters.map((x) => <a href={`/archive/personnel/${slugify(x)}/`}>{x}</a>)}</div></div>}
            {d.factions.length > 0 && <div class="archive-group"><a class="mission-label archive-group-link" href="/archive/factions/">Factions</a><div class="archive-list">{d.factions.map((x) => <a href={`/archive/factions/${slugify(x)}/`}>{x}</a>)}</div></div>}
            {d.worlds.length > 0 && <div class="archive-group"><a class="mission-label archive-group-link" href="/archive/worlds/">Worlds</a><div class="archive-list">{d.worlds.map((x) => <a href={`/archive/worlds/${slugify(x)}/`}>{x}</a>)}</div></div>}
            {d.technology.length > 0 && <div class="archive-group"><a class="mission-label archive-group-link" href="/archive/technology/">Technology</a><div class="archive-list">{d.technology.map((x) => <a href={`/archive/technology/${slugify(x)}/`}>{x}</a>)}</div></div>}
            {d.arcs.length > 0 && <div class="archive-group"><a class="mission-label archive-group-link" href="/archive/arcs/">Story arcs</a><div class="archive-list">{d.arcs.map((x) => <a href={`/archive/arcs/${slugify(x)}/`}>{x}</a>)}</div></div>}
          </div>
        </div>
      </aside>
    </div>
  </section>

  <nav class="mission-nav" aria-label="Episode navigation">
    <div class="shell mission-nav-grid">
      {previous ? <a class="mission-nav-card previous" href={`/episodes/${previous.id}/`}><span class="mission-label">Previous mission</span><strong>{previous.data.title}</strong><span>{previous.data.series} · S{previous.data.season}E{previous.data.episode}</span></a> : <div class="mission-nav-card mission-nav-empty"><span class="mission-label">Previous mission</span><strong>Archive start</strong><span>No earlier record loaded.</span></div>}
      {next ? <a class="mission-nav-card next" href={`/episodes/${next.id}/`}><span class="mission-label">Next mission</span><strong>{next.data.title}</strong><span>{next.data.series} · S{next.data.season}E{next.data.episode}</span></a> : <div class="mission-nav-card mission-nav-empty next"><span class="mission-label">Next mission</span><strong>Current position</strong><span>Awaiting the next rewatch entry.</span></div>}
    </div>
  </nav>

  <script id="mission-through-keys" type="application/json" set:html={JSON.stringify(throughKeys)}></script>
  <script is:inline src="/watch-progress.js"></script>
  <script is:inline>
    (() => {
      const panel = document.querySelector('.watch-panel');
      if (!panel || !window.ChevronWatch) return;
      const key = panel.dataset.watchKey;
      const throughKeys = JSON.parse(document.getElementById('mission-through-keys').textContent || '[]');
      const state = document.getElementById('mission-watch-state');
      const toggle = document.getElementById('mission-watch-toggle');
      const through = document.getElementById('mission-watch-through');
      const watchedContent = [...document.querySelectorAll('[data-watch-when="watched"]')];
      const unwatchedContent = [...document.querySelectorAll('[data-watch-when="unwatched"]')];
      const render = () => {
        const isWatched = window.ChevronWatch.watched(key);
        state.textContent = isWatched ? 'Watched ✓' : 'Not marked watched';
        state.classList.toggle('is-watched', isWatched);
        toggle.textContent = isWatched ? 'Mark unwatched' : 'Mark watched';
        watchedContent.forEach((node) => { node.hidden = !isWatched; });
        unwatchedContent.forEach((node) => { node.hidden = isWatched; });
      };
      toggle.addEventListener('click', () => window.ChevronWatch.mark(key, !window.ChevronWatch.watched(key)));
      through.addEventListener('click', () => window.ChevronWatch.markThrough(throughKeys));
      window.addEventListener('chevron-watch-change', render);
      render();
    })();
  </script>
</BaseLayout>

<style>
  .episode-reading { margin:0 0 1.4rem; padding:1.45rem; border:1px solid var(--line); border-radius:14px; background:rgba(17,23,27,.72); }
  .episode-reading h2 { margin:.35rem 0 .8rem; }
  .episode-reading > p { margin:0; color:var(--text); line-height:1.75; font-size:1rem; }
  .briefing-panel { border-color:var(--accent-soft); background:rgba(212,167,76,.045); }
  .briefing-lock { margin-top:1.1rem; padding-top:1rem; border-top:1px solid var(--line); color:var(--muted); font-size:.82rem; line-height:1.55; }
  .debrief-panel { background:linear-gradient(180deg,rgba(17,23,27,.88),rgba(17,23,27,.65)); }
  .why-it-matters { margin-top:1.4rem; padding-top:1.25rem; border-top:1px solid var(--line); }
  .why-it-matters h3 { margin:.35rem 0 .55rem; font-size:1.35rem; }
  .why-it-matters p { margin:0; color:var(--muted); line-height:1.72; }
  .previously-relevant { margin:0 0 1.4rem; padding:1.2rem; border:1px solid var(--line); border-radius:14px; background:rgba(17,23,27,.72); }
  .previously-relevant h2 { margin:.35rem 0 .35rem; }
  .previously-relevant-intro { margin:0 0 .85rem; color:var(--muted); font-size:.88rem; }
  .previously-relevant-list { display:grid; }
  .previously-relevant-list a { display:grid; grid-template-columns:95px minmax(0,1fr) 20px; gap:1rem; align-items:center; padding:.9rem 0; border-top:1px solid var(--line); text-decoration:none; }
  .previously-relevant-list a:hover .previously-relevant-copy > strong, .previously-relevant-list a:hover > b { color:var(--accent); }
  .previously-relevant-code { display:grid; gap:.16rem; }
  .previously-relevant-code span { color:var(--muted); font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; }
  .previously-relevant-code strong { color:var(--accent); font-size:.78rem; letter-spacing:.06em; }
  .previously-relevant-copy { display:grid; gap:.24rem; }
  .previously-relevant-copy > strong { color:var(--text); }
  .previously-relevant-copy span { color:var(--muted); font-size:.82rem; line-height:1.5; }
  .previously-relevant-list a > b { color:var(--muted); text-align:right; }
  .episode-thread-links { margin:0 0 1.4rem; padding:1.2rem; border:1px solid var(--line); border-radius:14px; background:rgba(17,23,27,.72); }
  .episode-thread-links h2 { margin:.35rem 0 1rem; }
  .episode-thread-list { display:grid; }
  .episode-thread-list a { display:flex; justify-content:space-between; gap:1.2rem; align-items:center; padding:.9rem 0; border-top:1px solid var(--line); text-decoration:none; }
  .episode-thread-list a > div:first-child { display:grid; gap:.25rem; }
  .episode-thread-list a strong { color:var(--accent); }
  .episode-thread-list a span { color:var(--muted); font-size:.82rem; line-height:1.45; }
  .episode-thread-meta { display:flex; gap:.4rem; align-items:center; white-space:nowrap; }
  .episode-thread-meta span { padding:.2rem .45rem; border:1px solid var(--line); border-radius:999px; text-transform:uppercase; font-size:.66rem !important; letter-spacing:.04em; }
  .episode-thread-meta b { color:var(--accent); }
  .continuity-panel { display:grid; gap:.8rem; }
  .continuity-weight { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-bottom:.7rem; border-bottom:1px solid var(--line); }
  .continuity-weight span { color:var(--muted); font-size:.78rem; }
  .continuity-weight strong { color:var(--accent); text-transform:uppercase; letter-spacing:.06em; font-size:.78rem; }
  .connection-pills { display:flex; flex-wrap:wrap; gap:.4rem; }
  .connection-pills span { padding:.22rem .48rem; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:.7rem; }
  .continuity-empty { margin:0; color:var(--muted); font-size:.76rem; line-height:1.45; }
  .watch-panel { display:grid; gap:.7rem; }
  .watch-state { color:var(--muted); }
  .watch-state.is-watched { color:var(--accent); }
  .watch-actions { display:grid; gap:.5rem; }
  .watch-action { width:100%; padding:.62rem .7rem; border:1px solid var(--line); border-radius:8px; background:transparent; color:var(--text); cursor:pointer; text-align:left; }
  .watch-action:hover { border-color:var(--accent-soft); color:var(--accent); }
  .primary-watch { border-color:var(--accent-soft); }
  .watch-order-link { margin-top:.15rem; font-size:.78rem; }
  .gated-sidebar-panel { margin-top:1rem; }
  [hidden] { display:none !important; }
  @media (max-width:650px) {
    .episode-thread-list a { align-items:flex-start; flex-direction:column; }
    .previously-relevant-list a { grid-template-columns:1fr 20px; gap:.45rem .8rem; }
    .previously-relevant-code { grid-column:1; display:flex; gap:.5rem; align-items:center; }
    .previously-relevant-copy { grid-column:1; }
    .previously-relevant-list a > b { grid-column:2; grid-row:1 / span 2; }
  }
</style>
