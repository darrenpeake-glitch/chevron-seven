---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { watchOrder, watchOrderIndex, watchKeyForEpisode, codeForWatchEntry } from '../../lib/watch-order';

export async function getStaticPaths() {
  const threads = (await getCollection('threads')).filter((entry) => !entry.data.draft);
  return threads.map((thread) => ({ params: { slug: thread.id }, props: { thread } }));
}

const { thread } = Astro.props;
const allEpisodes = (await getCollection('episodes')).filter((entry) => !entry.data.draft);
const milestones = thread.data.milestones;
const archivedEpisodeFor = (milestone) => allEpisodes.find((entry) =>
  entry.data.series === milestone.series &&
  entry.data.season === milestone.season &&
  entry.data.episode === milestone.episode
);
const codeFor = (milestone) => `S${String(milestone.season).padStart(2,'0')}E${String(milestone.episode).padStart(2,'0')}`;
const keyFor = (milestone) => watchKeyForEpisode(milestone.series, milestone.season, milestone.episode);
const clientWatchOrder = watchOrder.map((entry, index) => ({ key: entry.key, index, series: entry.series, title: entry.title, code: codeForWatchEntry(entry) }));
const clientMilestones = milestones.map((milestone, index) => ({ key: keyFor(milestone), index, orderIndex: watchOrderIndex.get(keyFor(milestone)) ?? -1 }));
---
<BaseLayout title={`${thread.data.name} · Narrative Thread · Chevron Seven`} description={thread.data.summary}>
  <section class="thread-hero">
    <div class="shell thread-hero-grid">
      <div>
        <div class="eyebrow">Long-game narrative · {thread.data.scope}</div>
        <h1 class="episode-title">{thread.data.name}</h1>
        <p class="lede">{thread.data.summary}</p>
      </div>
      <aside class="thread-status">
        <span class="mission-label">At your watch position</span>
        <strong id="thread-progress-status">CHECKING PROGRESS</strong>
        <span id="thread-progress-current">Watch Order progress controls this reveal.</span>
      </aside>
    </div>
  </section>

  <section class="mission-bar">
    <div class="shell mission-bar-inner">
      <div><span class="mission-label">Visible milestones</span><strong id="thread-visible-count">0</strong></div>
      <div><span class="mission-label">Full thread</span><strong>{milestones.length} milestones</strong></div>
      <div><span class="mission-label">Later milestones hidden</span><strong id="thread-hidden-count">{milestones.length}</strong></div>
    </div>
  </section>

  <section class="section">
    <div class="shell thread-layout">
      <main>
        <div class="section-heading">
          <div><div class="eyebrow">First-watch reading</div><h2>Narrative path</h2></div>
          <a class="text-link" href="/threads/">← All threads</a>
        </div>
        <p class="thread-intro">Only milestones established by episodes you have marked watched are shown here. Later connections remain hidden until your Watch Order progress reaches them or you deliberately open the full rewatch path.</p>

        <div class="thread-empty" id="thread-empty">No milestones in this thread have been reached in your saved watch progress yet.</div>
        <div class="thread-path" id="safe-thread-path">
          {milestones.map((milestone, index) => {
            const archived = archivedEpisodeFor(milestone);
            const stepContent = (
              <>
                <div class="thread-step-marker"><span>{String(index + 1).padStart(2,'0')}</span></div>
                <div class="thread-step-main">
                  <div class="thread-step-meta">
                    <span>{milestone.series} · {codeFor(milestone)}</span>
                    <span class={`thread-role role-${milestone.role}`}>{milestone.role.replace('-', ' ')}</span>
                    <span class={`thread-relevance relevance-${milestone.relevance}`}>{milestone.relevance}</span>
                  </div>
                  <h3>{milestone.title}</h3>
                  <p>{milestone.firstWatch}</p>
                </div>
              </>
            );
            return archived
              ? <a class="thread-step progress-gated" data-milestone-key={keyFor(milestone)} href={`/episodes/${archived.id}/`}>{stepContent}</a>
              : <div class="thread-step progress-gated" data-milestone-key={keyFor(milestone)}>{stepContent}</div>;
          })}
        </div>

        <div class="thread-horizon" id="thread-horizon">
          <div class="eyebrow">Current horizon</div>
          <strong id="thread-horizon-title">The thread is not yet revealed.</strong>
          <p id="thread-horizon-copy">Your saved Watch Order progress controls when milestones become visible.</p>
        </div>

        <details class="full-thread" id="full-thread">
          <summary>
            <span>Full rewatch path</span>
            <strong>Reveal later spoilers →</strong>
          </summary>
          <div class="full-thread-warning">Full-series spoilers for this narrative thread begin below.</div>
          <div class="thread-path full-thread-path" id="full-thread-path">
            {milestones.map((milestone, index) => {
              const archived = archivedEpisodeFor(milestone);
              const stepContent = (
                <>
                  <div class="thread-step-marker"><span>{String(index + 1).padStart(2,'0')}</span></div>
                  <div class="thread-step-main">
                    <div class="thread-step-meta">
                      <span>{milestone.series} · {codeFor(milestone)}</span>
                      <span class={`thread-role role-${milestone.role}`}>{milestone.role.replace('-', ' ')}</span>
                      <span class={`thread-relevance relevance-${milestone.relevance}`}>{milestone.relevance}</span>
                    </div>
                    <h3>{milestone.title}</h3>
                    <p>{milestone.rewatch ?? milestone.firstWatch}</p>
                  </div>
                </>
              );
              return archived
                ? <a class="thread-step full-thread-step" data-milestone-key={keyFor(milestone)} href={`/episodes/${archived.id}/`}>{stepContent}</a>
                : <div class="thread-step thread-step-future full-thread-step" data-milestone-key={keyFor(milestone)}>{stepContent}</div>;
            })}
          </div>
        </details>
      </main>

      <aside class="thread-sidebar">
        <div class="sidebar-panel">
          <div class="eyebrow">Current position</div>
          <div class="thread-current" id="thread-current"><strong>No saved progress</strong><span>Open Watch Order to set your position.</span></div>
          <a class="text-link thread-watch-link" href="/watch-order">Open Watch Order →</a>
        </div>
        <div class="sidebar-panel">
          <div class="eyebrow">Role key</div>
          <div class="role-key">
            <span>Breadcrumb</span><span>Development</span><span>Escalation</span><span>Reveal</span><span>Turning point</span><span>Payoff</span><span>Aftermath</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script id="thread-watch-order-data" type="application/json" set:html={JSON.stringify(clientWatchOrder)}></script>
  <script id="thread-milestone-data" type="application/json" set:html={JSON.stringify(clientMilestones)}></script>
  <script src="/watch-progress.js"></script>
  <script is:inline>
    (() => {
      if (!window.ChevronWatch) return;
      const order = JSON.parse(document.getElementById('thread-watch-order-data').textContent || '[]');
      const milestones = JSON.parse(document.getElementById('thread-milestone-data').textContent || '[]');
      const safeSteps = [...document.querySelectorAll('#safe-thread-path .progress-gated')];
      const fullSteps = [...document.querySelectorAll('#full-thread-path .full-thread-step')];

      const render = () => {
        const watched = new Set(window.ChevronWatch.load());
        const watchedOrderEntries = order.filter((entry) => watched.has(entry.key));
        const current = watchedOrderEntries.sort((a,b) => a.index - b.index).at(-1);
        const reached = milestones.filter((milestone) => watched.has(milestone.key));

        safeSteps.forEach((step) => step.classList.toggle('is-progress-visible', watched.has(step.dataset.milestoneKey)));
        document.getElementById('thread-empty').style.display = reached.length ? 'none' : 'block';
        document.getElementById('thread-visible-count').textContent = String(reached.length);
        document.getElementById('thread-hidden-count').textContent = String(milestones.length - reached.length);

        const status = document.getElementById('thread-progress-status');
        const currentCopy = document.getElementById('thread-progress-current');
        if (!current) {
          status.textContent = 'NO WATCH POSITION';
          currentCopy.textContent = 'Set progress in Watch Order to begin spoiler-safe reveals.';
        } else if (reached.length === milestones.length) {
          status.textContent = 'THREAD COMPLETE';
          currentCopy.textContent = `${current.series} · ${current.code} · ${current.title}`;
        } else {
          status.textContent = reached.length ? 'THREAD UNRESOLVED' : 'NOT YET REVEALED';
          currentCopy.textContent = `${current.series} · ${current.code} · ${current.title}`;
        }

        const currentPanel = document.getElementById('thread-current');
        currentPanel.innerHTML = current
          ? `<strong>${current.series} · ${current.code}</strong><span>${current.title}</span>`
          : '<strong>No saved progress</strong><span>Open Watch Order to set your position.</span>';

        const horizonTitle = document.getElementById('thread-horizon-title');
        const horizonCopy = document.getElementById('thread-horizon-copy');
        if (!reached.length) {
          horizonTitle.textContent = 'The thread is not yet revealed.';
          horizonCopy.textContent = `${milestones.length} milestones remain beyond your confirmed watch progress.`;
        } else if (reached.length < milestones.length) {
          horizonTitle.textContent = 'The thread remains unresolved.';
          horizonCopy.textContent = `${milestones.length - reached.length} later milestone${milestones.length - reached.length === 1 ? '' : 's'} remain hidden beyond your confirmed watch progress.`;
        } else {
          horizonTitle.textContent = 'Thread complete.';
          horizonCopy.textContent = 'Your confirmed watch progress has reached every milestone in this narrative thread.';
        }

        document.querySelectorAll('.rewatch-limit-marker').forEach((node) => node.remove());
        if (current) {
          const boundary = fullSteps.find((step) => {
            const milestone = milestones.find((item) => item.key === step.dataset.milestoneKey);
            return milestone && milestone.orderIndex > current.index;
          });
          if (boundary) {
            const marker = document.createElement('div');
            marker.className = 'rewatch-limit-marker';
            marker.innerHTML = `<span>CURRENT REWATCH LIMIT</span><strong>${current.series} · ${current.code}</strong>`;
            boundary.before(marker);
          }
        }
      };

      window.addEventListener('chevron-watch-change', render);
      render();
    })();
  </script>
</BaseLayout>

<style>
  .thread-hero { padding: 6.2rem 0 3.5rem; border-bottom: 1px solid var(--line); background: radial-gradient(circle at 82% 15%, rgba(212,167,76,.08), transparent 25rem); }
  .thread-hero-grid { display:grid; grid-template-columns:minmax(0,1fr) 290px; gap:3rem; align-items:end; }
  .thread-status { padding:1.2rem; border:1px solid var(--line); border-radius:14px; background:var(--panel); display:grid; gap:.45rem; }
  .thread-status strong { color:var(--accent); }
  .thread-status > span:last-child { color:var(--muted); font-size:.82rem; line-height:1.45; }
  .thread-layout { display:grid; grid-template-columns:minmax(0,1fr) 280px; gap:2rem; align-items:start; }
  .thread-intro { color:var(--muted); line-height:1.7; max-width:68ch; margin:-.25rem 0 1rem; }
  .thread-empty { padding:1.2rem 0; color:var(--muted); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .thread-path { display:grid; }
  .progress-gated { display:none; }
  .progress-gated.is-progress-visible { display:grid; }
  .thread-step { grid-template-columns:58px minmax(0,1fr); gap:1rem; padding:1.35rem 0; border-bottom:1px solid var(--line); text-decoration:none; }
  .thread-step-marker { position:relative; display:grid; place-items:start center; }
  .thread-step-marker::after { content:""; position:absolute; top:30px; bottom:-1.35rem; width:1px; background:var(--line); }
  .thread-step:last-child .thread-step-marker::after { display:none; }
  .thread-step-marker span { width:34px; height:34px; border:1px solid var(--accent-soft); border-radius:50%; display:grid; place-items:center; color:var(--accent); font-size:.72rem; font-weight:800; background:var(--bg); z-index:1; }
  .thread-step-main h3 { margin:.42rem 0 .38rem; font-size:1.22rem; }
  .thread-step-main p { margin:.3rem 0 0; color:var(--muted); line-height:1.62; max-width:68ch; }
  a.thread-step:hover h3 { color:var(--accent); }
  .thread-step-meta { display:flex; flex-wrap:wrap; gap:.45rem; align-items:center; color:var(--muted); font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; }
  .thread-role,.thread-relevance { padding:.2rem .45rem; border:1px solid var(--line); border-radius:999px; }
  .thread-role { color:var(--accent); }
  .relevance-primary { color:var(--text); }
  .thread-horizon { margin:1.7rem 0 0; padding:1.25rem 1.35rem; border:1px solid var(--accent-soft); border-radius:12px; background:rgba(212,167,76,.055); }
  .thread-horizon strong { display:block; margin:.35rem 0; font-size:1.15rem; }
  .thread-horizon p { margin:.3rem 0 0; color:var(--muted); line-height:1.55; }
  .full-thread { margin-top:1.6rem; border:1px solid var(--line); border-radius:14px; background:var(--panel); overflow:hidden; }
  .full-thread > summary { cursor:pointer; list-style:none; display:flex; justify-content:space-between; gap:1rem; padding:1.15rem 1.3rem; align-items:center; }
  .full-thread > summary::-webkit-details-marker { display:none; }
  .full-thread > summary span { font-weight:800; }
  .full-thread > summary strong { color:var(--accent); font-size:.82rem; }
  .full-thread[open] > summary { border-bottom:1px solid var(--line); }
  .full-thread-warning { padding:.85rem 1.3rem; color:var(--accent); font-size:.78rem; border-bottom:1px solid var(--line); background:rgba(212,167,76,.045); }
  .full-thread-path { padding:0 1.3rem 1rem; }
  .full-thread-step { display:grid; }
  .thread-step-future { opacity:.92; }
  .rewatch-limit-marker { margin:1rem 0; padding:.75rem 1rem; border-top:1px solid var(--accent-soft); border-bottom:1px solid var(--accent-soft); display:flex; justify-content:space-between; gap:1rem; color:var(--accent); font-size:.72rem; letter-spacing:.07em; }
  .rewatch-limit-marker strong { color:var(--text); }
  .thread-sidebar { position:sticky; top:96px; display:grid; gap:1rem; }
  .thread-current { display:grid; gap:.25rem; margin-top:.7rem; }
  .thread-current strong { color:var(--accent); }
  .thread-current span { color:var(--muted); }
  .thread-watch-link { display:inline-block; margin-top:.8rem; font-size:.78rem; }
  .role-key { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:.8rem; }
  .role-key span { padding:.25rem .5rem; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:.72rem; }
  @media (max-width:760px) { .thread-hero-grid,.thread-layout { grid-template-columns:1fr; } .thread-sidebar { position:static; } .full-thread > summary,.rewatch-limit-marker { align-items:flex-start; flex-direction:column; } }
</style>
