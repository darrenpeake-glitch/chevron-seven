---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const threads = (await getCollection('threads')).filter((entry) => !entry.data.draft);
  return threads.map((thread) => ({ params: { slug: thread.id }, props: { thread } }));
}

const { thread } = Astro.props;
const { Content } = await render(thread);
const episodes = (await getCollection('episodes'))
  .filter((entry) => !entry.data.draft)
  .filter((entry) => entry.data.narrativeThreads.some((link) => link.thread === thread.id))
  .sort((a, b) => {
    if (a.data.series !== b.data.series) return a.data.series.localeCompare(b.data.series);
    if (a.data.season !== b.data.season) return a.data.season - b.data.season;
    return a.data.episode - b.data.episode;
  });

const episodeCode = (entry) => `S${String(entry.data.season).padStart(2,'0')}E${String(entry.data.episode).padStart(2,'0')}`;
---
<BaseLayout title={`${thread.data.name} · Narrative Thread · Chevron Seven`} description={thread.data.summary}>
  <section class="thread-hero">
    <div class="shell thread-hero-grid">
      <div>
        <div class="eyebrow">Narrative thread · {thread.data.scope}</div>
        <h1 class="episode-title">{thread.data.name}</h1>
        <p class="lede">{thread.data.summary}</p>
      </div>
      <aside class="thread-status">
        <span class="mission-label">Thread status</span>
        <strong>{thread.data.status}</strong>
        <span>{episodes.length} relevant {episodes.length === 1 ? 'mission' : 'missions'}</span>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell thread-layout">
      <main>
        <div class="section-heading">
          <div><div class="eyebrow">Story path</div><h2>Relevant episodes</h2></div>
          <a class="text-link" href="/threads/">← All threads</a>
        </div>

        <div class="thread-path">
          {episodes.map((entry, index) => {
            const link = entry.data.narrativeThreads.find((item) => item.thread === thread.id);
            return (
              <a class="thread-step" href={`/episodes/${entry.id}/`}>
                <div class="thread-step-marker"><span>{String(index + 1).padStart(2,'0')}</span></div>
                <div class="thread-step-main">
                  <div class="thread-step-meta">
                    <span>{entry.data.series} · {episodeCode(entry)}</span>
                    <span class={`thread-role role-${link?.role}`}>{link?.role.replace('-', ' ')}</span>
                    <span class={`thread-relevance relevance-${link?.relevance}`}>{link?.relevance}</span>
                  </div>
                  <h3>{entry.data.title}</h3>
                  {link?.note && <p>{link.note}</p>}
                </div>
              </a>
            );
          })}
        </div>
      </main>

      <aside class="thread-sidebar">
        <div class="sidebar-panel">
          <div class="eyebrow">Thread rules</div>
          <p>Only episodes that materially contribute to this storyline appear here. A character, faction or technology merely appearing is not enough.</p>
        </div>
        <div class="sidebar-panel">
          <div class="eyebrow">Role key</div>
          <div class="role-key">
            <span>Breadcrumb</span><span>Development</span><span>Escalation</span><span>Reveal</span><span>Turning point</span><span>Payoff</span><span>Aftermath</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section thread-briefing-section">
    <div class="shell thread-briefing mission-article"><Content /></div>
  </section>
</BaseLayout>

<style>
  .thread-hero { padding: 6.2rem 0 3.5rem; border-bottom: 1px solid var(--line); background: radial-gradient(circle at 82% 15%, rgba(212,167,76,.08), transparent 25rem); }
  .thread-hero-grid { display: grid; grid-template-columns: minmax(0,1fr) 260px; gap: 3rem; align-items: end; }
  .thread-status { padding: 1.2rem; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); display: grid; gap: .45rem; }
  .thread-status strong { color: var(--accent); }
  .thread-status > span:last-child { color: var(--muted); font-size: .82rem; }
  .thread-layout { display: grid; grid-template-columns: minmax(0,1fr) 280px; gap: 2rem; align-items: start; }
  .thread-path { display: grid; }
  .thread-step { display: grid; grid-template-columns: 58px minmax(0,1fr); gap: 1rem; padding: 1.3rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .thread-step-marker { position: relative; display: grid; place-items: start center; }
  .thread-step-marker::after { content:""; position:absolute; top: 30px; bottom: -1.3rem; width:1px; background: var(--line); }
  .thread-step:last-child .thread-step-marker::after { display:none; }
  .thread-step-marker span { width: 34px; height: 34px; border: 1px solid var(--accent-soft); border-radius: 50%; display:grid; place-items:center; color: var(--accent); font-size:.72rem; font-weight:800; background:var(--bg); z-index:1; }
  .thread-step-main h3 { margin:.4rem 0 .35rem; font-size:1.2rem; }
  .thread-step-main p { margin:.3rem 0 0; color:var(--muted); line-height:1.55; }
  .thread-step:hover h3 { color:var(--accent); }
  .thread-step-meta { display:flex; flex-wrap:wrap; gap:.45rem; align-items:center; color:var(--muted); font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; }
  .thread-role,.thread-relevance { padding:.2rem .45rem; border:1px solid var(--line); border-radius:999px; }
  .thread-role { color:var(--accent); }
  .relevance-primary { color:var(--text); }
  .thread-sidebar { position:sticky; top:96px; display:grid; gap:1rem; }
  .thread-sidebar p { color:var(--muted); line-height:1.55; font-size:.88rem; }
  .role-key { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:.8rem; }
  .role-key span { padding:.25rem .5rem; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:.72rem; }
  .thread-briefing-section { padding-top:0; }
  .thread-briefing { max-width:780px; margin-left:auto; margin-right:auto; }
  @media (max-width: 760px) { .thread-hero-grid,.thread-layout { grid-template-columns:1fr; } .thread-sidebar { position:static; } }
</style>
